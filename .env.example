# Copy this file to ".env" on your server and fill it in. Never share or upload your real .env file.

# The port the website runs on inside the server (Caddy forwards myrightmyride.com to it).
PORT=3000

# Password for the owner panel at https://myrightmyride.com/admin  (at least 8 characters; make it long).
ADMIN_PASSWORD=change-this-to-a-long-secret-password

# Login OTP by SMS.
#   console = testing only: no SMS is sent, the code is printed in the server log.
#   http    = real SMS through any Indian SMS company (MSG91, Fast2SMS, Textlocal, etc.).
SMS_PROVIDER=console
# Testing only: also show the OTP on the login screen. Must be false (or removed) on the live site.
SHOW_OTP_ON_SCREEN=false

# For SMS_PROVIDER=http: your SMS company's send address, with {phone} and {otp} where the number and code go.
# Your SMS company gives you this address and key. Indian SMS needs a DLT-registered template.
# SMS_HTTP_URL=https://sms-company.example/api/send?key=YOUR_KEY&to=91{phone}&message=Your+myrightmyride+OTP+is+{otp}
# SMS_HTTP_METHOD=GET
# SMS_HTTP_BODY=
# SMS_HTTP_HEADERS={}

# Where the database file is kept (default: data/myrightmyride.db). Back this file up every day.
# DB_FILE=/home/ride/myrightmyride.com/data/myrightmyride.db
